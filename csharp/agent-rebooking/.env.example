# LLM provider. ollama runs against a local, host-side Ollama with no remote calls.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_FALLBACK_PROVIDER=

# Ollama runs on the HOST, not in Compose. From a container, it is reachable at
# host.docker.internal. Run `ollama pull qwen3.5:9b` before the first run; it takes
# a few minutes on CPU.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Hosted providers. Code and docs only -- keys stay empty. No remote LLM calls
# without explicit permission.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The service refuses to start a hosted provider (LLM_PROVIDER other than ollama)
# unless this is explicitly true. Keeps a key exported in a developer's shell from
# reaching a paid provider because of a mistyped LLM_PROVIDER.
ALLOW_HOSTED_PROVIDER=false

# Postgres connection for the booking store the MCP tools read from.
#
# Left commented on purpose. Docker Compose reads this file as its own interpolation
# source, so anything live here wins over the default in compose.yaml and goes into the
# app container, where localhost:5433 is nothing and the app exits applying the schema.
# Compose supplies the in-network value, Host=postgres;Port=5432, on its own.
#
# The line below is the host-side path to the same database, for `dotnet run` outside
# Compose. It is already the app's built-in default, so export it in your shell only if
# you moved the published port. Do not uncomment it here.
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5433;Database=agentrebooking;Username=postgres;Password=postgres

# Approval gate
APPROVAL_LIMIT=300
APPROVAL_TIMEOUT_SECONDS=600

# Run lifecycle
RUN_TIMEOUT_SECONDS=300
RUN_TTL_SECONDS=3600

# Telemetry
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_SERVICE_NAME=agent-rebooking
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Compose sets this literally to http://otel-collector:4318, because inside the network
# the collector is only reachable by service name. It is not settable under Compose. The
# line below is the host-side value, for `dotnet run` outside Compose, where the
# collector's published port is what you reach. Unset, the app skips the OTLP exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LLM cost table. Read by the gateway to price tokens; it is not what the approval gate
# prices from. The image ships it at /app/pricing.json, which is the default.
# PRICING_FILE=/app/pricing.json

# base14 Scout export, consumed by the collector
# Left empty on purpose. A filled-in placeholder passes the collector's own validation,
# so the collector starts, looks healthy, and silently fails every export against a
# tenant that does not exist. Empty, it exits with the error the README quotes.
SCOUT_ENDPOINT=
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENVIRONMENT=development
