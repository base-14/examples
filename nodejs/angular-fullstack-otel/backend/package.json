{
  "name": "angular-items-api",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Express + Postgres API for the Angular full-stack OpenTelemetry example",
  "scripts": {
    "build": "tsc",
    "start": "node -r ./dist/instrumentation.js ./dist/server.js",
    "dev": "tsc && npm start"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "cors": "^2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "^10.4.0"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.14.5",
    "brace-expansion": ">=5.0.12",
    "qs": ">=6.16.1",
    "systeminformation": ">=5.33.16",
    "gaxios": "^7.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
