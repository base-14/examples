{
  "name": "angular-items-api",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Express + Postgres API for the Angular full-stack OpenTelemetry example",
  "scripts": {
    "build": "tsc",
    "start": "node -r ./dist/instrumentation.js ./dist/server.js",
    "dev": "tsc && npm start"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "pg": "8.23.0",
    "pino": "^10.3.1"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "minimatch": ">=10.2.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.3"
  }
}
