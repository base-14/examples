# ── LLM Provider ──────────────────────────────────────────────────────────────
# Pick one: ollama (default) | anthropic | google
LLM_PROVIDER=ollama

# Optional: the provider to switch to when the primary exhausts its retries.
# FALLBACK_PROVIDER=ollama
# FALLBACK_MODEL=qwen3.5:9B

# ── Embedding Provider ─────────────────────────────────────────────────────────
# Pick one: ollama (default) | openai | google
EMBEDDING_PROVIDER=ollama

# ── API Keys (required only for the active provider) ───────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# ── Ollama (required when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama) ───
# Run Ollama locally: https://ollama.ai
# Docker Compose reaches the host's Ollama through host.docker.internal. Use http://localhost:11434 when running the app directly on the host, or http://ollama:11434 with the ollama compose profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama serves a 4096-token context by default, which the extract and score
# stages overrun. Raise it to 32768. The Ollama daemon reads this at startup,
# not this app, so setting it here has no effect on a daemon that is already
# running: see the Prerequisites section of the README for the way to set it
# for a Homebrew service, the macOS app, a daemon you start yourself, or
# systemd. Check with `ollama ps`, which prints a CONTEXT column.
OLLAMA_CONTEXT_LENGTH=32768

# ── Model overrides (optional - provider defaults shown) ──────────────────────
# Ollama:     qwen3.5:9B / qwen3.5:9B
# Anthropic:  claude-sonnet-4-6 / claude-haiku-4-5-20251001
# Google:     gemini-2.5-flash / gemini-2.5-flash-lite
LLM_MODEL_CAPABLE=qwen3.5:9B
LLM_MODEL_FAST=qwen3.5:9B

# Ollama embed: embeddinggemma
# OpenAI embed: text-embedding-3-small
# Google embed: gemini-embedding-001
EMBEDDING_MODEL=embeddinggemma

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/contract_analyzer

# Server
PORT=3000

# OpenTelemetry
OTEL_SERVICE_NAME=ai-contract-analyzer
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Prompts and completions stay out of telemetry unless this is true. When it is
# true they are PII-scrubbed and truncated before they reach a span event.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Base14 Scout (OTel Collector)
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=
SCOUT_ENVIRONMENT=
