{
  "name": "ai-contract-analyzer",
  "version": "1.0.0",
  "description": "AI-powered contract analysis pipeline with OpenTelemetry observability",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules dist coverage .next *.tsbuildinfo",
    "reset": "docker compose down -v --remove-orphans",
    "dev": "bun run --watch --preload ./src/telemetry.ts src/index.ts",
    "start": "bun run --preload ./src/telemetry.ts src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome check src tests",
    "format": "bunx biome format --write src tests",
    "check": "bun run typecheck && bun run build && bun run lint && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "bash scripts/test-api.sh",
    "verify": "bash scripts/verify-scout.sh",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "seed": "bun run scripts/seed-data.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/provider": "4.0.35",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "ai": "7.0.159",
    "hono": "4.13.14",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pgvector": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@types/pg": "8.23.1",
    "bun-types": "1.4.4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
