{
  "name": "express5-postgres",
  "version": "1.1.0",
  "description": "Express 5 + PostgreSQL + OpenTelemetry Example",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist coverage .next *.tsbuildinfo",
    "reset": "docker compose down -v --remove-orphans",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/jobs/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "bash scripts/test-api.sh",
    "test:websocket": "node scripts/test-websocket.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "build:lint": "npm run build && npm run lint",
    "check": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-socket.io": "^0.69.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "overrides": {
    "engine.io": ">=6.6.10",
    "@grpc/grpc-js": ">=1.14.5",
    "@grpc/proto-loader": {
      "protobufjs": "^7.5.6"
    },
    "qs": ">=6.16.0",
    "esbuild": "^0.28.1",
    "uuid": ">=14.0.0",
    "ws": ">=8.21.0",
    "brace-expansion": ">=5.0.12",
    "socket.io-parser": ">=4.2.7",
    "body-parser": ">=2.3.0",
    "postcss": ">=8.5.18",
    "minimatch": ">=10.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
