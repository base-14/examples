{
  "name": "nextjs-api-mongodb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules dist coverage .next *.tsbuildinfo",
    "reset": "docker compose down -v --remove-orphans",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "worker": "tsx --import ./src/jobs/instrumentation.ts src/jobs/worker.ts",
    "build:worker": "esbuild src/jobs/instrumentation.ts src/jobs/worker.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --external:bullmq --external:ioredis --external:pino --external:@opentelemetry/*",
    "test": "vitest run",
    "test:api": "./scripts/test-api.sh",
    "build-lint": "next build && npm run lint",
    "check": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bcrypt": "6.0.0",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.3",
    "next": "^16.4.2",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.14.5",
    "@grpc/proto-loader": {
      "protobufjs": "^7.5.6"
    },
    "postcss": ">=8.5.18",
    "uuid": ">=14.0.0",
    "@babel/core": ">=7.29.6",
    "js-yaml": ">=5.4.1",
    "brace-expansion": ">=5.0.12",
    "minimatch": ">=10.2.5",
    "nanoid": "^3.3.17",
    "sharp": ">=0.35.5",
    "browserslist": ">=4.28.7",
    "source-map-js": ">=1.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
