{
  "name": "trpc-postgres-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node --require ./dist/tracing.js ./dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "@trpc/server": "^11.18.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.14.4",
    "@grpc/proto-loader": {
      "protobufjs": "^7.5.6"
    },
    "hono": "^4.12.34",
    "@hono/node-server": ">=2.0.5",
    "fast-uri": ">=4.1.2",
    "esbuild": "^0.28.1",
    "brace-expansion": ">=5.0.9",
    "minimatch": ">=10.2.5",
    "valibot": ">=1.4.2",
    "mysql2": ">=3.22.0"
  }
}
