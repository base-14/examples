# The port the HTTP server binds, for a host run (make start). compose.yaml publishes
# 3000 and does not pass this through, so it moves a host run only. Set it if something
# else on the machine already holds 3000.
PORT=3000

# LLM provider. ollama runs against a local, host-side Ollama with no remote calls.
# openai and anthropic are code paths only in this scaffold; no hosted call is made.
LLM_PROVIDER=ollama

# Ollama runs on the HOST, not in Compose. Run `ollama pull qwen3.5:9B` and
# `ollama pull gemma4:e2b` before the first run.
#
# Left empty on purpose, because the right value depends on where the service runs and
# both cases already have a working default. A host-side run (make start) uses the
# service's own default of http://localhost:11434/api; a container gets
# http://host.docker.internal:11434/api from compose.yaml, since localhost inside a
# container is the container and host.docker.internal does not resolve on the host. A
# value set here would be copied into .env and override both.
#
# Whatever you set, keep the /api suffix. ollama-ai-provider-v2 builds every request URL
# as baseURL + path, where path is already /chat, so a base URL without /api sends every
# model call to /chat and Ollama answers 404.
OLLAMA_BASE_URL=

# Ollama's own default context window is 4096 tokens, which a lead run overruns partway
# through: sixteen steps of accumulated tool results come back as an empty response with
# done_reason "length". Sent as providerOptions.ollama.options.num_ctx. 16384 is the
# largest window that holds qwen3.5:9B to 5.91 GB of VRAM, against 6.47 GB at 32768, which
# is what keeps this runnable on a 16 GB machine. For scale, the largest single prompt
# measured over 601 model calls was 10984 tokens and the 95th percentile was 3716.
OLLAMA_NUM_CTX=16384

# Subtopic agents use the small model, the lead agent and escalation use the large one.
MODEL_SMALL=gemma4:e2b
MODEL_LARGE=qwen3.5:9B

# Price row applied to local token counts. Left empty here and in compose.yaml: with it
# empty the service borrows gpt-5-nano's rates, the cheapest current small-model row in
# _shared/pricing.json, so a local run reports a plausible cost instead of zero. The rate
# is borrowed, not a bill for anything: every cost computed this way carries
# base14.gen_ai.cost.simulated=true. Set this to another id from _shared/pricing.json to
# price the same token counts at that model's rates.
PRICE_MODEL=

# deferred sends only the tools a role needs; full sends every tool to every agent,
# for the measurement.
TOOL_CATALOGUE=deferred

# Fan-out and escalation caps.
MAX_SUBTOPICS=8
MAX_ESCALATIONS=2

# The service refuses to construct a hosted provider (LLM_PROVIDER other than ollama)
# unless this is explicitly true. Left empty on purpose. No remote LLM calls without
# explicit permission.
ALLOW_HOSTED_PROVIDER=

# Prompts and completions are off by default; the collector still records token counts.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# base14 Scout export, consumed by the collector, not by the app.
# Left empty on purpose, and the stack runs that way: with SCOUT_CLIENT_ID empty the
# collector loads config/otel-collector.yaml alone, receives, filters and prints to its
# debug exporter, and make verify passes. Nothing here is needed to run the example.
# Fill all four in to export to a base14 tenant. Do not fill in placeholders: a made-up
# value passes the collector's own validation, so the collector would start, look
# healthy, and silently fail every export against a tenant that does not exist.
SCOUT_ENDPOINT=
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENVIRONMENT=development
