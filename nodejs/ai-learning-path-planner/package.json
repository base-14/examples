{
  "name": "ai-learning-path-planner",
  "version": "1.0.0",
  "description": "Lead agent fans out to one subagent per subtopic over base14's docs and examples corpus, with OpenTelemetry showing the fan-out cost",
  "type": "module",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/telemetry.ts src/index.ts",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run lint && npm run test",
    "test:api": "bash scripts/test-api.sh",
    "index": "tsx scripts/build-index.ts"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.150",
    "@hono/node-server": "2.1.5",
    "@mastra/core": "1.79.0",
    "@mastra/observability": "1.21.0",
    "@mastra/otel-bridge": "1.5.18",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "ai": "7.0.150",
    "hono": "4.13.13",
    "ollama-ai-provider-v2": "4.1.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.14.5"
  }
}
