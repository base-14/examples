APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/data_analyst?sslmode=disable

LLM_PROVIDER=ollama
LLM_MODEL_CAPABLE=qwen3.5:9B
LLM_MODEL_FAST=qwen3.5:9B
FALLBACK_PROVIDER=ollama
FALLBACK_MODEL=qwen3.5:9B
# Docker Compose reaches the host's Ollama through host.docker.internal. Use http://localhost:11434 when running the app directly on the host, or http://ollama:11434 with the ollama compose profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=
SCOUT_ENVIRONMENT=

OTEL_SERVICE_NAME=ai-data-analyst
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# Records prompt and completion text on the inference details event. Off by
# default: message content is sensitive and increases span size and cost.
# Enable it when you need full prompt and response capture and accept the
# privacy implications.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=1024
