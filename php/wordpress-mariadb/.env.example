# Replace these with your Base14 Scout credentials.
# The placeholder values below let the collector start without real credentials,
# which is enough to capture spans locally. Export to Scout only works once these
# are real.
#
# Compose reads these from your shell FIRST and only falls back to this file for
# names the shell does not export. If SCOUT_ENDPOINT is already exported (CI,
# direnv, an earlier `set -a && source .env`), editing it here changes nothing -
# the stack keeps exporting to whatever tenant the shell names. Run
# `unset SCOUT_ENDPOINT SCOUT_CLIENT_ID SCOUT_CLIENT_SECRET SCOUT_TOKEN_URL`
# first if you want this file to be the source of truth.
SCOUT_ENDPOINT=https://otlp.example.invalid
SCOUT_CLIENT_ID=placeholder
SCOUT_CLIENT_SECRET=placeholder
SCOUT_TOKEN_URL=https://auth.example.invalid/token

# Host ports for the two deployment profiles. Change these if 8080/8081 are
# already taken on your machine - nothing else needs to change.
WP_APACHE_PORT=8080
WP_FPM_PORT=8081

# Host port for the collector's Prometheus metrics endpoint. Change if 8888
# is already taken. scripts/verify-scout.sh reads this variable too, so
# export it into the shell you run the script from (set -a && source .env &&
# set +a) - a value that only Compose sees leaves the script looking at 8888,
# and the script fails at [2/8] rather than reading every counter as zero.
COLLECTOR_METRICS_PORT=8888
