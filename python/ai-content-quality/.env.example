# AI Content Quality Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Provider: "ollama" | "openai" | "google" | "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9B
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=300.0

# Fallback provider (used if primary provider fails after all retries)
FALLBACK_PROVIDER=ollama
FALLBACK_MODEL=qwen3.5:9B

# Provider API keys (only the active provider's key is required). Leave blank
# to run on Ollama only.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4

# Google Gemini (LLM_PROVIDER stays "google"; telemetry reports it as gcp.gemini):
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.7-flash

# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4.5

# Docker Compose reaches the host's Ollama through host.docker.internal. Use http://localhost:11434 when running the app directly on the host, or http://ollama:11434 with the ollama compose profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Context window requested from Ollama per call. LlamaIndex otherwise asks for the model's full trained length (262144 for qwen3.5:9B), which makes every call several times slower on a laptop.
OLLAMA_CONTEXT_WINDOW=32768
# Thinking models such as qwen3.5 reason before answering unless told not to; leave false so a review is a few hundred tokens rather than over a thousand.
OLLAMA_REASONING=false

# =============================================================================
# OPENTELEMETRY / BASE14 SCOUT
# =============================================================================

# Service identification
SERVICE_NAME=ai-content-quality
SCOUT_ENVIRONMENT=

# Docker Compose reaches the collector service by name; use http://localhost:4318 when running the app directly on the host.
OTLP_ENDPOINT=http://otel-collector:4318

# Enable/disable telemetry (set to "true" to disable)
OTEL_SDK_DISABLED=false

# Emit the latest GenAI attribute names rather than the deprecated ones
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Capture prompt/completion content on spans (opt-in, disabled by default for PII safety)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Base14 Scout credentials (for OTel Collector → Scout export)
# Get these from https://app.base14.io/settings/api-keys
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=

# =============================================================================
# APPLICATION
# =============================================================================

# Prompt version configuration
REVIEW_PROMPT_VERSION=v1
IMPROVE_PROMPT_VERSION=v1
SCORE_PROMPT_VERSION=v1

# Request timeout (seconds) for LLM analysis endpoints
REQUEST_TIMEOUT=600.0

HOST=0.0.0.0
PORT=8000
