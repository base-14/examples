# Instrumentation mode: auto (OpenLLMetry) | callback (custom) | off
INSTRUMENTATION_MODE=callback

# LLM provider. Default = Ollama (local, no key). Model must be tool-capable.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9B
# From a container, Ollama on the host is reachable via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud alternatives (uncomment + set a key to use; not required for Ollama)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/runbooks

OTEL_SERVICE_NAME=ai-runbook-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
SCOUT_ENVIRONMENT=development
# Content capture (sensitive; off by default)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Scout collector auth (for otel-collector-config.yaml). Leave blank for local runs.
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=https://auth.base14.io/oauth/token
SCOUT_ENDPOINT=https://collector.base14.io
