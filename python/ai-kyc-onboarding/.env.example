# Copy this file to .env and fill in your values.

# Temporal
TEMPORAL_TASK_QUEUE=kyc-onboarding

# Ollama. Use http://localhost:11434 when running the app outside Docker Compose.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EXTRACTION_MODEL=gemma4:e2b
ASSESSMENT_MODEL=qwen3.5:9B
EXTRACTION_PROMPT_VERSION=v1
ASSESSMENT_PROMPT_VERSION=v3

# Database. Use host port 5433 when running the app outside Docker Compose.
KYC_DB_DSN=postgresql://temporal:temporal@postgres:5432/kyc

# Fault injection. When true, the worker reads each case's fault from the case_faults table.
KYC_FAULTS_ENABLED=false

# Case defaults: days to wait for documents and for a review, and model requests per case.
DOCUMENT_DEADLINE_DAYS=3
REVIEW_DEADLINE_DAYS=2
REQUEST_BUDGET=40

# OpenTelemetry. Use http://localhost:4318 when running the app outside Docker Compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SDK_DISABLED=false
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Captures prompt and completion content because the fixtures are synthetic. Set to false for
# real applicant data.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

SCOUT_ENVIRONMENT=

# Base14 Scout credentials, from https://app.base14.io/settings/api-keys.
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=
