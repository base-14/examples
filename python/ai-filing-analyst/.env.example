# Required. The SEC refuses requests without a name and a contact email.
# https://www.sec.gov/search-filings/edgar-search-assistance/accessing-edgar-data
SEC_USER_AGENT=Your Company Name your.email@example.com

# The agent framework: strands, adk, maf or openai-agents. Rebuild the API after changing it.
FILING_FRAMEWORK=strands

# Models on the host's Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
ANALYST_MODEL=qwen3.5:9B
RANKING_MODEL=gemma4:e2b
OLLAMA_THINK=false
# A prompt version is the UTC timestamp prefix of its file under prompts/, such as 202609261523.
# Blank uses the newest file.
ANALYST_PROMPT_VERSION=
RANKING_PROMPT_VERSION=

# SEC client limits.
SEC_REQUESTS_PER_SECOND=5
SEC_BACKOFF_SECONDS=600
SEC_CALLS_PER_QUESTION=4

# Per-question budgets.
CALL_BUDGET=24
QUESTION_TIMEOUT_SECONDS=240
QUESTION_MAX_CHARS=500

# Accepts the fault and budget overrides on POST /questions. Keep false outside the scenario harness.
FILING_FAULTS_ENABLED=false

# Standard OpenTelemetry variables.
OTEL_SERVICE_NAME=ai-filing-analyst
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
OTEL_PYTHON_LOG_CORRELATION=true

# base14 Scout. Leave blank here and export them in your shell, or paste them.
SCOUT_ENVIRONMENT=
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=
