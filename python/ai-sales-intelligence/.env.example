# AI Sales Intelligence - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Primary LLM provider: "ollama" | "anthropic" | "google" | "openai"
LLM_PROVIDER=ollama

# Capable model, used for complex tasks (enrich, draft)
LLM_MODEL_CAPABLE=qwen3.5:9B

# Fast model, used for lighter tasks (score, evaluate)
LLM_MODEL_FAST=qwen3.5:9B

# Fallback provider (used when the primary fails after retries)
FALLBACK_PROVIDER=ollama
FALLBACK_MODEL=qwen3.5:9B

# Docker Compose reaches the host's Ollama through host.docker.internal. Use http://localhost:11434 when running the app directly on the host, or http://ollama:11434 with the ollama compose profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# API keys for the hosted providers. Leave blank to run on Ollama only.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# LLM generation settings
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/sales_intelligence

# =============================================================================
# OPENTELEMETRY / BASE14 SCOUT
# =============================================================================

# Service identification
OTEL_SERVICE_NAME=ai-sales-intelligence
SCOUT_ENVIRONMENT=

# Local OTel Collector endpoint (for docker compose setup)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enable/disable telemetry (set to "false" to disable)
OTEL_ENABLED=true

# Emit the latest GenAI attribute names rather than the deprecated ones
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Record prompt and completion content on the GenAI inference event.
# Off by default: the content may contain PII.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Base14 Scout credentials (for OTel Collector → Scout export)
# Get these from https://app.base14.io/settings/api-keys
SCOUT_CLIENT_ID=
SCOUT_CLIENT_SECRET=
SCOUT_TOKEN_URL=
SCOUT_ENDPOINT=

# =============================================================================
# APPLICATION
# =============================================================================

APP_NAME=ai-sales-intelligence
LOG_LEVEL=INFO
DEBUG=false
